# Godot's import cache and editor state. Regenerated on open; never commit.
.godot/
src/.godot/

# Gate artefacts.
.checklogs/
.godot_doc/

# Private kit runtime. May contain reduced session evidence, dispatch prompts,
# worker logs, process state and provider thread ids. Never commit or package.
.kit/

# Vendored third-party bundle, fetched only by an explicit `kit setup dependency`
# action. Not source, and
# a few MB of minified JS in every diff is noise. plan.html degrades to
# readable diagram source without it.
tools/vendor/
.gate.sha256.bak
*.bak

# Python.
__pycache__/
*.pyc
.venv/
venv/

# Exported builds.
build/
export/
*.exe
*.pck
*.apk
*.aab
*.dmg
*.zip

# OS noise.
.DS_Store
Thumbs.db
desktop.ini

# Editor noise.
.vscode/
.idea/
*.swp
*~

# Generated plan view. Rewritten by the gate on every run, so committing it
# produces noise on every commit. plan/ SNAPSHOTS are deliberately NOT ignored:
# they are the record of how the plan moved between slices.
plan.html

# Generated design index. Authored sections under docs/design/ are durable;
# this retrieval projection is regenerated from them and must not dirty a
# canonical kit or a project after verification.
docs/design/INDEX.md

# Generated retrospective board, for the same reason: rewritten on every gate
# run and on every board request. docs/retro/*-findings.md is the durable
# record; this is only a view of it.
retro.html

# DO NOT ADD:
#   *.import   - Godot import metadata. Ignoring it forces a full reimport on
#                every clone and can change asset UIDs.
#   *.uid      - Script/resource identity. Ignoring it breaks every scene-to-
#                script link on a fresh clone.
#   project.godot, export_presets.cfg, .gutconfig.json - project configuration.
#   plan/*.html - per-slice snapshots. The comparison between them is the
#                 record of how the design changed; losing it loses the audit.

# Retro working files. The evidence pack is regenerated on demand and the SDK
# scratch dir holds a generated bridge script, so neither belongs in history.
# docs/retro/*.md IS committed -- the findings are the durable record.
docs/retro/evidence.json
docs/retro/prompt.md
docs/retro/.sdk/
docs/retro/.ran

# Board runtime state and worker transcripts. The board rewrites these while it
# runs and the logs are per-machine scratch, so they are noise in history. The
# durable records are docs/retro/{accepted,deferred}.json and the findings.
docs/retro/board.log
docs/retro/board.state.json
docs/retro/queue/
docs/retro/runs/
